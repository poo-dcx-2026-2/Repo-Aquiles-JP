@startuml
title Entrega 3 — acervo de jogos, circulação, persistência e relatórios
skinparam classAttributeIconSize 0
hide empty members
left to right direction
interface Biblioteca
interface AcervoService
interface UsuarioService
interface EmprestimoService
interface RelatorioService
class Fabrica
class BibliotecaInicial
class AcervoEmMemoria
class UsuariosEmMemoria
class EmprestimosEmMemoria
class RelatoriosEmMemoria {
  emprestimosPorCategoria() : Map<String, Long>
  taxaDeOcupacaoDoAcervo() : double
  itensMaisEmprestados(n) : List<ItemView>
  usuariosComAtraso(data) : List<UsuarioView>
  importarItensEmLote(arquivo) : int
}
class DemoRelatorios
class EstadoBiblioteca {
  itens : Map<String, Item>
  exemplares : Map<String, Exemplar>
  usuarios : Map<String, Usuario>
  emprestimos : Map<String, Emprestimo>
  reservas : Map<String, Reserva>
  snapshot()
  reconstruir(dados)
  substituir(novo)
}
class Circulacao {
  emprestar(tombo, matricula, data)
  devolver(tombo, data)
  reservar(codigo, matricula, data)
  cancelar(id)
  desativar(matricula)
  baixar(tombo)
}
class Item {
  codigo : String
  titulo : String
  view() : ItemView
  separarProxima(exemplar)
}
class Exemplar {
  tombo : String
  codigoDoItem : String
  status : StatusExemplar
  exigirEmprestavel(usuario, reserva)
  baixar()
}
class Usuario {
  matricula : String
  nome : String
  ativo : boolean
  emprestimosAtivos() : int
  exigirLimite()
  desativar()
}
class Emprestimo {
  id : String
  data : LocalDate
  prevista : LocalDate
  devolucao : LocalDate
  devolver(data)
  atrasado(referencia) : boolean
}
class Reserva {
  id : String
  data : LocalDate
  situacao : ATIVA | ATENDIDA | CANCELADA
  separar(exemplar)
  voltarAEsperar()
  encerrar(situacao)
}
class JogoDeTabuleiro {
  codigoDoItem : String
  jogadoresMinimos : int
  jogadoresMaximos : int
  comportaGrupo(quantidadeDeJogadores) : boolean
}
class ArquivoBiblioteca {
  salvar(dados)
  carregar() : DadosBiblioteca
}
class DadosBiblioteca <<record>>
class ReservaDados <<record>>
Fabrica ..> BibliotecaInicial : cria vazia
BibliotecaInicial ..|> Biblioteca
BibliotecaInicial *-- AcervoEmMemoria
BibliotecaInicial *-- UsuariosEmMemoria
BibliotecaInicial *-- EmprestimosEmMemoria
BibliotecaInicial *-- RelatoriosEmMemoria
BibliotecaInicial *-- "1" EstadoBiblioteca
BibliotecaInicial *-- ArquivoBiblioteca
AcervoEmMemoria ..|> AcervoService
UsuariosEmMemoria ..|> UsuarioService
EmprestimosEmMemoria ..|> EmprestimoService
RelatoriosEmMemoria ..|> RelatorioService
AcervoEmMemoria --> EstadoBiblioteca
UsuariosEmMemoria --> EstadoBiblioteca
AcervoEmMemoria *-- Circulacao
UsuariosEmMemoria *-- Circulacao
EmprestimosEmMemoria *-- Circulacao
Circulacao --> EstadoBiblioteca
RelatoriosEmMemoria --> EstadoBiblioteca : consulta
DemoRelatorios ..> Fabrica
DemoRelatorios ..> RelatorioService
EstadoBiblioteca o-- "0..*" Item : indexa
EstadoBiblioteca o-- "0..*" Exemplar : indexa
EstadoBiblioteca o-- "0..*" Usuario : indexa
EstadoBiblioteca o-- "0..*" Emprestimo : indexa
EstadoBiblioteca o-- "0..*" Reserva : indexa
Item "1" *-- "0..*" Exemplar
Item "1" o-- "0..*" Reserva : ordem de chegada
Usuario "1" o-- "0..*" Emprestimo : histórico
Emprestimo "0..*" --> "1" Exemplar
Reserva "0..*" --> "1" Usuario
Reserva "0..1" --> "0..1" Exemplar : separado
JogoDeTabuleiro "0..1" --> "1" Item : associação por código
ArquivoBiblioteca ..> DadosBiblioteca
EstadoBiblioteca ..> DadosBiblioteca
DadosBiblioteca *-- "0..*" ReservaDados
note bottom of JogoDeTabuleiro
  Extensão: 1 <= mínimo <= máximo.
  Associação por código, sem herança.
end note
note bottom of ArquivoBiblioteca
  Única classe com E/S.
  dados/biblioteca-v2.txt ou biblioteca.dados.
end note
@enduml
